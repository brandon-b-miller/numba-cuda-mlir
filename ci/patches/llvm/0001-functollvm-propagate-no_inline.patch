From: numba-cuda-mlir
Subject: [PATCH] [mlir][FuncToLLVM] Propagate no_inline to the converted llvm.func

func.func and llvm.func both declare `no_inline` as an inherent attribute.
Inherent attributes are not part of getDiscardableAttrs(), which is the set
convert-func-to-llvm copies across, so the marker is silently dropped and any
inliner running after the conversion is free to inline a callee the source
explicitly asked to keep.

numba-cuda-mlir hits this with `@cuda.jit(device=True, inline="never")` under
debug=True: the two inline passes that run while the function is still
func.func honour the attribute, the one that runs after convert-func-to-llvm
does not, and the resulting debug metadata is rejected by the LLVM verifier
because the callee's DILocalVariables end up in the caller's subprogram.

`always_inline` needs no equivalent change: func.func does not declare it, so
where it is set it is already discardable and is carried across as-is.

Upstream status: not yet submitted. Remove this patch once it lands and the
diff --git a/mlir/lib/Conversion/FuncToLLVM/FuncToLLVM.cpp b/mlir/lib/Conversion/FuncToLLVM/FuncToLLVM.cpp
index 2686158f67..14f1d4a643 100644
--- a/mlir/lib/Conversion/FuncToLLVM/FuncToLLVM.cpp
+++ b/mlir/lib/Conversion/FuncToLLVM/FuncToLLVM.cpp
@@ -54,6 +54,7 @@ using namespace mlir;
 static constexpr StringRef varargsAttrName = "func.varargs";
 static constexpr StringRef linkageAttrName = "llvm.linkage";
 static constexpr StringRef barePtrAttrName = "llvm.bareptr";
+static constexpr StringRef noInlineAttrName = "no_inline";
 
 /// Return `true` if the `op` should use bare pointer calling convention.
 static bool shouldUseBarePtrCallConv(Operation *op,
@@ -333,6 +334,13 @@ static LLVM::LLVMFuncOp createLLVMFuncOp(FunctionOpInterface funcOp,
   cast<FunctionOpInterface>(newFuncOp.getOperation())
       .setVisibility(funcOp.getVisibility());
 
+  // `no_inline` is inherent on func.func as well as on llvm.func, so it is
+  // absent from the discardable attributes carried across above and has to be
+  // propagated by hand. Losing it lets an inliner running after this
+  // conversion inline a callee the source explicitly marked.
+  if (funcOp->hasAttr(noInlineAttrName))
+    newFuncOp.setNoInline(true);
+
   // Set readnone memory effects
   if (funcOp->hasAttr(LLVM::LLVMDialect::getReadnoneAttrName())) {
     auto memoryAttr = LLVM::MemoryEffectsAttr::get(
diff --git a/mlir/test/Conversion/FuncToLLVM/convert-funcs.mlir b/mlir/test/Conversion/FuncToLLVM/convert-funcs.mlir
index a648c415bb..598fc7c1ec 100644
--- a/mlir/test/Conversion/FuncToLLVM/convert-funcs.mlir
+++ b/mlir/test/Conversion/FuncToLLVM/convert-funcs.mlir
@@ -35,6 +35,10 @@ func.func private @llvmlinkage(i32) attributes { "llvm.linkage" = #llvm.linkage<
 // CHECK-SAME: memory_effects = #llvm.memory_effects<other = none, argMem = none, inaccessibleMem = none, errnoMem = none, targetMem0 = none, targetMem1 = none>
 func.func private @llvmreadnone(i32) attributes { llvm.readnone }
 
+// CHECK-LABEL: llvm.func @llvmnoinline(i32)
+// CHECK-SAME: no_inline
+func.func private @llvmnoinline(i32) attributes { no_inline }
+
 // CHECK-LABEL: llvm.func @body(i32)
 func.func private @body(i32)
 
